        $('#chkChkAll').click(function (e) {
            var table = $(e.target).closest('table');
            $('td input:checkbox', table).prop('checked', this.checked);
        });

        function BindDescription(opnumber) {
            debugger;
            var VoucherNo = opnumber;
            var UrlLink = '@UrlLink';

            $.ajax({
                url: "@Url.Action("Op_Voucher_History_Description", "MISOPEReport")",
                type: "get",
                DataType: "json",
                async: false,
                contenttype: "application/json; charset=utf-8",
                data: { VoucherNo: VoucherNo },
                success: function (result) {
                    debugger;
                    var a = JSON.parse(result);
                    $("#tblusers tbody").empty();
                    let date = [a[0].PCH_Approval_Date, a[0].AdminQA_Approval_Date, a[0].CH_Approval_Date];
                    let DeductMandays = [a[0].DeductMandays_Pch, a[0].DeductMandays_Admin, a[0].DeductMandays_Ch];
                    let Name_ = [a[0].PCH_Name, a[0].AdminQA_Approval, a[0].CH_Approval];

                    var Data = ["PCH", "AdminQA", "ClusterHead"];
                    let k = 0;
                    var myArray = [];
                    for (var i = 0; i < a.length; i++) {
                        if (!!a[i].PCH_Approval_Description) {
                            myArray.push(a[i].PCH_Approval_Description);
                            k++;
                        }
                        if (!!a[i].AdminQA_Description) {
                            myArray.push(a[i].AdminQA_Description);
                            k++;
                        }
                        if (!!a[i].CH_Approval_Description) {
                            myArray.push(a[i].CH_Approval_Description);
                            k++;

                        }
                        for (var j = 0; j < myArray.length; j++) {
                            $("#tblusers").append('<tr><td>' + date[j] + '</td><td>' + Data[j] + '</td><td>' + Name_[j] + '</td><td>' + myArray[j] + '</td><td>' + DeductMandays[j] + '</td></tr>')
                        }

                    }
                    $('#remarksModal').modal('show');
                },
                error: function (result) {
                    debugger;
                    (result + "something went wrong");
                }
            });
        }


    $('#btnApprove').click(function (e) {
        debugger;
            e.preventDefault();
            if (!confirm('Do you want to proceed with voucher(s) approval?')) return;

            var isValid = true;
            var firstInvalidRow = null;

            $('#example tbody tr').each(function () {
                var deductDays = parseFloat($(this).find('input[id^="txtDeductdays_"]').val()) || 0;
                var remarks = $(this).find('input[id^="txtRemarks_"]').val().trim();

                if (deductDays > 0 && remarks === "") {
                    isValid = false;
                    $(this).find('input[id^="txtRemarks_"]').css('border', '2px solid red');
                    if (!firstInvalidRow) firstInvalidRow = $(this);
                } else {
                    $(this).find('input[id^="txtRemarks_"]').css('border', '');
                }
            });

            if (!isValid) {
                alert("Please fill remarks for all rows where OPE is deducted.");
                if (firstInvalidRow) {
                    $('html, body').animate({
                        scrollTop: firstInvalidRow.offset().top - 100
                    }, 500);

                    firstInvalidRow.css('background-color', '#ffdddd');
                    setTimeout(function () {
                        firstInvalidRow.css('background-color', '');
                    }, 2000);
                }
                return;
            }

            $("body").prepend('<div id="preloader"></div>');
            $("#btnApprove").prop('disabled', true);

            var UrlLink = '@UrlLink';
            var i = 0;
            var Data = [];
            var _OP_Number = "";

            $("#example input[type=checkbox]:checked").each(function () {
                if ($(this).attr('id') === 'chkChkAll') return true;

                i++;
                var row = $(this).closest("tr")[0];
                var _rowIndex = row.rowIndex - 1;
                var checkboxId = $(this).attr('id');
                _OP_Number = checkboxId;
                var OP_Number = $('#example tbody tr:eq(' + _rowIndex + ') td:eq(2) label').text();
                var TotalAmount = $('#example tbody tr:eq(' + _rowIndex + ') td:eq(9) label').text();
                var DeductAmount_ = $('#example tbody tr:eq(' + _rowIndex + ') td:eq(8) input[type="text"]').val();
                var WorkingDays_ = $('#example tbody tr:eq(' + _rowIndex + ') td:eq(6) label').text();
                var complaints_ = $('#example tbody tr:eq(' + _rowIndex + ') td:eq(7) label').text();
                var ApprovedAmount = $('#example tbody tr:eq(' + _rowIndex + ') td:eq(10) input[type="text"]').val();
                var ApprovedRemarks = $('#example tbody tr:eq(' + _rowIndex + ') td:eq(11) input[type="text"]').val();
                var Days = $('#example tbody tr:eq(' + _rowIndex + ') td:eq(13) label').text();
                var Utilize = $('#example tbody tr:eq(' + _rowIndex + ') td:eq(14) label').text();
                Data.push({
                    row_num: i,
                    Op_Num: checkboxId,
                    OP_Number: checkboxId,
                    Remarks: ApprovedRemarks,
                    ApprovedAmount: ApprovedAmount,
                    TotalAmount: TotalAmount,
                    Deduct_Mandays: DeductAmount_,
                    WorkingMandays: WorkingDays_,
                    Complaints: complaints_,
                    Days: Days,
                    Utilize: Utilize

                });
            });
            var Data1 = JSON.stringify(Data);
            $.ajax({
                url: '@Url.Action("GetOPBulk_ApprovalList","OPE")',
                type: "post",
                dataType: "json",
                data: { Data1: Data1, _OP_Number: _OP_Number },
                success: function (response) {
                    var a = JSON.parse(response);
                    GetOPApprovalList();
                    $('#chkChkAll').prop('checked', false);
                },
                error: function (xhr, status, error) {
                    console.error(error);
                },
                complete: function () {
                    $("#preloader").remove();
                    $("#btnApprove").prop('disabled', false);
                }
            });
        });

        function OnChangeDays(i, inputValue) {
            debugger;
            var value = inputValue;
            if (value === '') {
                return false;
            }
            var Days_ = parseFloat(inputValue);
            var Days_deduct = isNaN(Days_) ? 0 : Days_;
            var Actual_amount = $('#VAmount_' + i).text();
            var amount = Days_deduct * 275;
            var deduct_Amount = Actual_amount - amount;
            $('#txtAprAmt_' + i).val(deduct_Amount);
        }

        function Get_Data() {
            debugger;
            var month = $("#month").val();
            var year = $("#year").val();

            window.location.href = '@Url.Action("Export_IndexOpeReport_", "OPE")'
                + '?month=' + encodeURIComponent(month)
                + '&year=' + encodeURIComponent(year);
        }
</script>
