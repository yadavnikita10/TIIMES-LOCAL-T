                <table id="visitDiaryTable" class="display responsive nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>Edit</th>
                            <th>Inspector Name</th>
                            <th>Date of Inspection</th>
                            <th>IVR No</th>
                            <th>Vendor Name</th>
                            <th>Job Number</th>
                            <th>SAP Number</th>
                            <th>Inspection Authority Reference No</th>
                            <th>Boliers Maker No</th>
                            <th>Form No Certificate No</th>
                            <th>Quality Offered Final Inspection</th>
                            <th>Size</th>
                            <th>No For Lot Invoicing</th>
                            <th>Boiler Owner</th>
                            <th>Boiler Manufacturer</th>
                            <th>Boiler Component Manufacturer</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.lstData)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Downloadfile) && item.Pk_id != 0)
                    {
                                        <a href="@Url.Action("VisitReportForm", "VisitReport", new {
                            PK_CALL_ID = Convert.ToInt32(item.Downloadfile),
                            PK_RM_ID = item.Pk_id,
                            PK_IVR_ID = item.PK_IVR_ID
                        })" title="Edit">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                    }
                                </td>
                                <td>@item.Person</td>
                                <td>@item.DateofInspection</td>
                                <td>@item.IVRRefNo</td>
                                <td>@item.VendorName</td>
                                <td>@item.JobNumber</td>
                                <td>@item.Sapnumber</td>
                                <td>@item.Inspection_Authority_ReferenceNo</td>
                                <td>@item.Boliers_Maker_No</td>
                                <td>@item.Form_no_Certificate_No</td>
                                <td>@item.Quality_offered_Final_Inspection</td>
                                <td>@item.Size</td>
                                <td>@item.No_For_lot_invoicing</td>
                                <td>@item.BolierOwner</td>
                                <td>@item.BoilerManufacturer</td>
                                <td>@item.BoilerComponentManufacturer</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<script type="text/javascript">
    $(document).ready(function () {
        $("#btnSearch").click(function myfunction() {
            debugger;
            if (ValidateForm() == false) {
                return false;
            }
            else {
                $("#form1").submit()
            }
        });
    });

    function ValidateForm() {

        if ($("#FromD").val() == "") {
            alert('Select From Date!');
            return false;
        }
        if ($("#ToD").val() == "") {
            alert('Select To Date!');
            return false;
        }
        debugger;
        if ($("#FromD").val() > $("#ToD").val()) {
            alert("To Date selected is Greater than From Date  !!!");
            return false;
        }

        else {
            return true;

        }
    }



    $('#btnExport').click(function () {
        var from = $('.FromD').val();
        var to = $('.ToD').val();

        if (!from || !to) {
            alert("Please select both From and To dates.");
            return;
        }

        var url = '@Url.Action("ExportBoilerInspectionExcel", "VisitReport")'
                  + "?fromDate=" + encodeURIComponent(from)
                  + "&toDate=" + encodeURIComponent(to);

        window.location.href = url;
    });

</script>

<script>
    $(function () {
        $(".FromD, .ToD").datepicker({
            dateFormat: 'dd/mm/yy',
            changeMonth: true,
            changeYear: true,
            yearRange: "-100:+50"
        });

        $('#visitDiaryTable').DataTable({
            //responsive: true,
            pageLength: 10,
            "scrollX": true,
            "scrollY": "400px",
            lengthMenu: [5, 10, 25, 50, 100],
            order: [],
            language: {
                emptyTable: "No data found"
            }
        });
    });

</script>

