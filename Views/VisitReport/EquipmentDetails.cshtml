                        @*<a href="@Url.Action("CallsListByInspector","CallsMaster")" class="btn btn-info dynamic-function-btn dynamic-function-btn-2"><i class="fa fa-long-arrow-left"></i> Go Back</a>*@

                        <div class="col-xs-12">


                            @if (Model.PK_CALL_ID != 0)
            {
                                <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("VisitReportForm", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID =PK_RM_ID} )'">General</button>
                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("ItemDescription", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID =PK_RM_ID} )'"> Item Description</button>
                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("ReferenceDocuments", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID = PK_RM_ID} )'">Reference Documents </button>
                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("InspectionActivites", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID = PK_RM_ID} )'">Stages Witnessed</button>
                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("DocumentReviewed", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID =PK_RM_ID} )'">Document Reviewed</button>
                                        <button class="btn btn-default insert-form-btn" type="button" onclick="location.href='@Url.Action("EquipmentDetails", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID = PK_RM_ID} )'">Details Of Measuring Instrument</button>
                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("Conclusion", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID = PK_RM_ID} )'">Conclusion</button>

                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("ReportImage", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID =PK_RM_ID} )'">Image</button>
                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("IvrReports", "VisitReport",new { @PK_CALL_ID = Model.PK_CALL_ID,@PK_RM_ID =PK_RM_ID} )'">Report</button>
                                        @*<button class="btn btn-info dynamic-function-btn" type="button" onclick="location.href='@Url.Action("IvrReports", "VisitReport",new { @PK_CALL_ID = Model.PK_CALL_ID} )'">Report</button>*@
                                <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("AllConcern", "VisitReport",new { @PK_CALL_ID = Model.PK_CALL_ID , @PK_RM_ID =PK_RM_ID} )'">List of Issues</button>

                            }




                        </div>


                        <div class="col-xs-12">
                            <div class="white-bg section-box-shadow">
                                <h3 class="form-page-title">Details Of Measuring instrument</h3>
                                <div class="col-xs-12 col-sm-12">
                                    <div class="form-group">
                                        <span style="color:#E12F24;">
                                        <br />
                                            <strong>Note </strong> :
                                        </span> 1) Providing details of measuring instruments is mandatory.<br />
                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2) If the master list is referred during inspection, mention the  “Master list number” in the field “Detail of Equipment(s)/Instrument(s).”.<br />
                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3) If no measuring instruments are used during the inspection, specify “Not applicable” in the field “Detail of Equipment(s)/Instrument(s).”.<br />
                                       
                                    </div>
                                </div>
                                <div class="col-xs-12">
                                    <hr class="custom-hr1 line">
                                </div>

                                <div class="row">
                                    <div class="col-xs-12 col-sm-offset-1 col-sm-10">

                                        <div class="form-box">
                                            <form method="post" enctype="multipart/form-data">

                                                @Html.HiddenFor(m => m.PK_CALL_ID)
                                                <div class="table-responsive">
                                                    <table class="table table-bordered table-striped" id="itemTable">
                                                        <thead style="background-color: #100ED2;color: white;">
                                                            <tr>
                                                                <th>Detail of Equipment(s)/Instrument(s):</th>
                                                                <th>Range</th>
                                                                <th>ID</th>
                                                                <th>Calibration Valid Till date:</th>
                                                                <th>Certification Number with Date:</th>
                                                                <th>NABL</th>
                                                                <th>Non NABL</th>
                                                                <th>Action</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="itemContainer">
                                                            @{
                                                                int i = 0;
                                                            }
                                                            @if (ViewData["CostSheet"] != null && ((IEnumerable<TuvVision.Models.EquipmentDetailsModel>)ViewData["CostSheet"]).Any())
                                                            {

                                                                foreach (var item in (IEnumerable<TuvVision.Models.EquipmentDetailsModel>)ViewData["CostSheet"])
                                                                {
                                                                    <tr class="item-row">
                                                                        <td>
                                                                            <textarea type="text" name="lstEquipmentDetails[@i].Name_Of_Equipments"
                                                                                      value="@item.Name_Of_Equipments" class="form-control"></textarea>
                                                                        </td>
                                                                        <td>
                                                                            <input type="text" name="lstEquipmentDetails[@i].Range"
                                                                                   value="@item.Range" class="form-control" />
                                                                        </td>
                                                                        <td>
                                                                            <input type="text"
                                                                                   name="lstEquipmentDetails[@i].Id"
                                                                                   value="@item.Id"
                                                                                   class="form-control autoExpandX" />
                                                                        </td>
                                                                        <td>
                                                                            <input type="text" name="lstEquipmentDetails[@i].CalibrationValid_Till_date"
                                                                                   value="@item.CalibrationValid_Till_date" class="form-control" />
                                                                        </td>
                                                                        <td>
                                                                            <input type="text" name="lstEquipmentDetails[@i].Certification_No_Date"
                                                                               value="@item.Certification_No_Date" class="form-control CertificationFrom" />
                                                                        </td>
                                                                        <td>
                                                                            <input type="checkbox" name="lstEquipmentDetails[@i].NABLseenote1" style="height:19px;"
                                                                                   value="@item.NABLseenote1" class="CertificationFrom" />
                                                                        </td>
                                                                        <td>
                                                                            <input type="checkbox" name="lstEquipmentDetails[@i].NonNABLseenote2" style="height:19px;"
                                                                                   value="@item.NonNABLseenote2" class="CertificationFrom" />
                                                                        </td>


                                                                        

                                                                        <td class="text-center">
                                                                            <button type="button" class="btn btn-danger removeRow">X</button>
                                                                        </td>
                                                                    </tr>
                                                                    i++;
                                                                }
                                                            }

                                                            else
                                                            {
                                                                <tr class="item-row">
                                                                    <td><textarea type="text" name="lstEquipmentDetails[0].Name_Of_Equipments" class="form-control"></textarea></td>
                                                                    <td><input type="text" name="lstEquipmentDetails[0].Range" class="form-control" /></td>
                                                                    <td><textarea name="lstEquipmentDetails[0].Id" class="form-control"></textarea></td>
                                                                    
                                                                    <td><input type="text" name="lstEquipmentDetails[0].CalibrationValid_Till_date" class="form-control" /></td>
                                                                    <td><input type="text" name="lstEquipmentDetails[0].Certification_No_Date" class="form-control" /></td>
                                                                    <td><input type="checkbox" name="lstEquipmentDetails[0].NABLseenote1" class="form-control" style="height:19px;" /></td>

                                                                    <td><input type="checkbox" name="lstEquipmentDetails[0].NABLseenote2" class="form-control" style="height:19px;" /></td>

                                                                   
                                                                    <td class="text-center">
                                                                        <button type="button" class="btn btn-danger removeRow">X</button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <div class="text-right">
                                                    <button type="button" class="btn btn-success" id="addRow" style="float:left;">Add Row</button>
                                                    <br />
                                                </div>


                                                
                                                
                                                <div class="col-xs-12 text-center" id="IVRPointerEvents">
                                                    <button type="submit" class="btn btn-default insert-form-btn">Save</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        $(".Name_Of_Equipments").autocomplete({
            source: function (request, response) {
                debugger
                $.ajax({
                    url: '@Url.Action("GetEquipments", "VisitReport")',
                    data: "{ 'prefix': '" + request.term + "'}",
                    dataType: "json",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {

                        response($.map(data, function (item) {
                            debugger
                            return { label: item.CompanyName, value: item.CompanyName };


                        }));
                    },
                    error: function (response) {
                        //alert(response.responseText);
                    },
                    failure: function (response) {
                        //  alert(response.responseText);
                    }
                });
            },
            select: function (e, i) {
                //if (u.item.val == -1) {
                //    return false;
                //}
                //$("#hfCompanyName").val(i.item.val);
            },
            minLength: 2
        });

    });


    $(document).ready(function () {
        var rowIndex = $("#itemContainer .item-row").length;

        $("#addRow").click(function () {
            var newRow = $(".item-row:first").clone(true);

            newRow.find("input, textarea, select").each(function () {
                var name = $(this).attr("name");
                if (name) {
                    var newName = name.replace(/\[\d+\]/, '[' + rowIndex + ']');
                    $(this).attr("name", newName).val('');
                }
            });

          
            $("#itemContainer").append(newRow);
            rowIndex++;
        });

        $(document).on("click", ".removeRow", function () {
            if ($("#itemContainer .item-row").length > 1) {
                $(this).closest(".item-row").remove();
            }
        });
    });

</script>
                                    
