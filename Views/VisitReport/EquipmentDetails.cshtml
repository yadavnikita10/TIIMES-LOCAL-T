@model TuvVision.Models.EquipmentDetailsModel

@{
    ViewBag.Title = "EquipmentDetails";
    Layout = "~/Views/Shared/_TuvVision.cshtml";
}

@*DATEPICKER*@
<script src="https://code.jquery.com/jquery-1.10.2.js"></script>
<script src="https://code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css" />


<script type="text/javascript" language="javascript" src="~/AllJsAndCss/datatable/js/jquery.dataTables.js"></script>
<script src="~/AllJsAndCss/datatable/js/jquery.dataTables.js"></script>
<script src="~/AllJsAndCss/js/datatable-custom.js"></script>
@{
    int PK_RM_ID = Convert.ToInt32(Session["PK_RM_ID"]);
    //Session["PK_RM_ID"] = Model.abcid;
}

@{
    var lstdetails = ViewData["CostSheet"]
        as List<TuvVision.Models.EquipmentDetailsModel>
        ?? new List<TuvVision.Models.EquipmentDetailsModel>
        {
            new TuvVision.Models.EquipmentDetailsModel()
        };
}



@{
    var items = ViewData["CostSheet"] as List<TuvVision.Models.ItemDescriptionModel>;
}

<script>

    $(function () {
        $(".CertificationTO").datepicker({
            dateFormat: 'dd/MM/yy',//check change
            changeMonth: true,
            changeYear: true,
            yearRange: "-100:+50"
        });
    });
</script>
<style>
    .ui-widget-header {
        background: #001ED2 !important;
    }
    .ui-datepicker-month, .ui-datepicker-year {
        color: #333 !important;
    }
</style>
        <div class="main-content3 xs-max-height grey-bg-f3">
    <div class="grey-bg-f3">
        <div class="container-fluid">
            <div class="col-xs-12 col-sm-offset-1 col-sm-10">
                <div class="col-xs-12 form-col">
                    <div class="row">
                        <br />
                        <h5 class="dynamic-page-title dynamic-page-title-2 " style="padding-left: 11px;">Inspection Visit Report Number : @Session["VisitReportNo"]</h5>
                        <div class="col-xs-12">
                            @if (Model.PK_CALL_ID != 0)
                          {
                                <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("VisitReportForm", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID =PK_RM_ID} )'">General</button>
                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("ItemDescription", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID =PK_RM_ID} )'"> Item Description</button>
                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("ReferenceDocuments", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID = PK_RM_ID} )'">Reference Documents </button>
                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("InspectionActivites", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID = PK_RM_ID} )'">Stages Witnessed</button>
                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("DocumentReviewed", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID =PK_RM_ID} )'">Document Reviewed</button>
                                        <button class="btn btn-default insert-form-btn" type="button" onclick="location.href='@Url.Action("EquipmentDetails", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID = PK_RM_ID} )'">Details Of Measuring Instrument</button>
                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("Conclusion", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID = PK_RM_ID} )'">Conclusion</button>
                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("ReportImage", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID,@PK_RM_ID =PK_RM_ID} )'">Image</button>
                                        <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("IvrReports", "VisitReport",new { @PK_CALL_ID = Model.PK_CALL_ID,@PK_RM_ID =PK_RM_ID} )'">Report</button>
                                <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("AllConcern", "VisitReport",new { @PK_CALL_ID = Model.PK_CALL_ID , @PK_RM_ID =PK_RM_ID} )'">List of Issues</button>
                            }
                        </div>
                        <div class="col-xs-12">
                            <div class="white-bg section-box-shadow">
                                <h3 class="form-page-title">Details Of Measuring instrument</h3>
                                <div class="col-xs-12 col-sm-12">
                                    <div class="form-group">
                                        <span style="color:#E12F24;">
                                        <br />
                                            <strong>Note </strong> :
                                        </span> 1) Providing details of measuring instruments is mandatory.<br />
                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2) If the master list is referred during inspection, mention the  “Master list number” in the field “Detail of Equipment(s)/Instrument(s).”.<br />
                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3) If no measuring instruments are used during the inspection, specify “Not applicable” in the field “Detail of Equipment(s)/Instrument(s).”.<br /> 
                                    </div>
                                </div>
                                <div class="col-xs-12">
                                    <hr class="custom-hr1 line">
                                </div>
                                <div class="row">
                                    <div class="col-xs-12 col-sm-offset-1 col-sm-10">
                                        <div class="form-box">
                                            <form method="post" enctype="multipart/form-data">
                                                @Html.HiddenFor(m => m.PK_CALL_ID)
                                                <button type="button" id="btnClearNew" class="btn btn-default insert-form-btn" style="margin-top:0px;background-color:#e63646" onclick="return confirm('Do you want to clear Content?')"><i class="fa "></i> Clear Content</button>

@{
    var equipmentList = ViewData["CostSheet"] as List<TuvVision.Models.EquipmentDetailsModel>;
    if (equipmentList == null || equipmentList.Count == 0)
    {
        equipmentList = new List<TuvVision.Models.EquipmentDetailsModel>
        {
            new TuvVision.Models.EquipmentDetailsModel()
        };
    }
}


                                                <div class="table-responsive">
                                                    <table class="table table-bordered table-striped" id="itemTable">
                                                        <thead style="background-color:#100ED2;color:white;">
                                                            <tr>
                                                                <th>Equipment</th>
                                                                <th>Range</th>
                                                                <th>ID</th>
                                                                <th>Calibration Till</th>
                                                                <th>Certification No</th>
                                                                <th>NABL</th>
                                                                <th>Non NABL</th>
                                                                <th>Action</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>
                                                            @for (int i = 0; i < Model.lstEquipmentDetails.Count; i++)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        @Html.TextAreaFor(m => m.lstEquipmentDetails[i].Name_Of_Equipments,
                new { @class = "form-control", rows = 2 })
                                                                    </td>

                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.lstEquipmentDetails[i].Range,
                new { @class = "form-control" })
                                                                    </td>

                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.lstEquipmentDetails[i].Id,
                new { @class = "form-control" })
                                                                    </td>

                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.lstEquipmentDetails[i].CalibrationValid_Till_date,
                new { @class = "form-control" })
                                                                    </td>

                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.lstEquipmentDetails[i].Certification_No_Date,
                new { @class = "form-control" })
                                                                    </td>

                                                                    @*<td class="text-center">
                                                                        @Html.CheckBoxFor(m => m.lstEquipmentDetails[i].NABLseenote1)
                                                                    </td>

                                                                    <td class="text-center">
                                                                        @Html.CheckBoxFor(m => m.lstEquipmentDetails[i].NonNABLseenote2)
                                                                    </td>*@
                                                                    <td class="text-center">
                                                                        @Html.CheckBoxFor(m => m.lstEquipmentDetails[i].NABLseenote1, new { @class = "single-check" })
                                                                    </td>

                                                                    <td class="text-center">
                                                                        @Html.CheckBoxFor(m => m.lstEquipmentDetails[i].NonNABLseenote2, new { @class = "single-check" })
                                                                    </td>


                                                                    <td>
                                                                        <button type="button" class="btn btn-danger removeRow">X</button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>

                                                    </table>


                                                    @*<button type="button" class="btn btn-primary" id="addRow">Add Row</button>*@
                                                </div>




                                                @*<button type="button" id="addRow" class="btn btn-success">Add Row</button>*@

                                                <div class="text-right">
                                                    <button type="button" class="btn btn-success" id="addRow" style="float:left;">Add Row</button>
                                                    <br />
                                                </div>

                                                <div class="col-xs-12 text-center" id="IVRPointerEvents">
                                                    <button type="submit" class="btn btn-default insert-form-btn">Save</button>
                                                </div>
                                            </form>     
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

