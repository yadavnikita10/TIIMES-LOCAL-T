@model TuvVision.Models.ItemDescriptionModel

@{
    ViewBag.Title = "ItemDescription";
    Layout = "~/Views/Shared/_TuvVision.cshtml";
    int PK_RM_ID = Convert.ToInt32(Session["PK_RM_ID"]);
}


<script src="~/AllJsAndCss/datatable/js/jquery.dataTables.js"></script>
<script src="~/AllJsAndCss/js/datatable-custom.js"></script>
<style>
 .autoExpandX {
    min-width: 200px;
    width: 170px;
    transition: width 0.2s ease;
}

</style>
<div class="main-content3 xs-max-height grey-bg-f3">
    <div class="grey-bg-f3">
        <!--Start of header-->
        <div class="container-fluid">
            <div class="col-xs-12 col-sm-offset-1 col-sm-10">
                @*row assignfixedwidth rp-5*@

                <div class="col-xs-12 form-col">
                    <div class="row">
                        <br />
                        @*<h3 class="dynamic-page-title dynamic-page-title-2">Item Description </h3>*@
                        <h5 class="dynamic-page-title dynamic-page-title-2 " style="padding-left: 11px;">Inspection Visit Report Number : @Session["VisitReportNo"]</h5>
                        @*<a href="@Url.Action("CallsListByInspector","CallsMaster")" class="btn btn-info dynamic-function-btn dynamic-function-btn-2"><i class="fa fa-long-arrow-left"></i> Go Back</a>*@

                        <div class="col-xs-12">
                            @*text-right*@


                            @if (Model.PK_CALL_ID != 0)
                            {
                                <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("VisitReportForm", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID, @PK_RM_ID = PK_RM_ID} )'"> General</button>
                                @*<button class="btn btn-info dynamic-function-btn ItemDescription" type="button" onclick="location.href='@Url.Action("ItemDescription", "VisitReport",new { @PK_Call_ID = Model.PK_Call_ID} )'">Item Description</button>*@

                                <button class="btn btn-default insert-form-btn" type="button" onclick="location.href='@Url.Action("ItemDescription", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID, @PK_RM_ID = PK_RM_ID} )'">Item Description</button>

                                <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("ReferenceDocuments", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID, @PK_RM_ID = PK_RM_ID} )'">Reference Documents</button>
                                <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("InspectionActivites", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID, @PK_RM_ID = PK_RM_ID} )'">Stages Witnessed</button>
                                <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("DocumentReviewed", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID, @PK_RM_ID = PK_RM_ID} )'">Document Reviewed</button>
                                <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("EquipmentDetails", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID, @PK_RM_ID = PK_RM_ID} )'">Details Of Measuring Instrument</button>
                                <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("Conclusion", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID, @PK_RM_ID =PK_RM_ID} )'">Conclusion</button>

                                <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("ReportImage", "VisitReport",new { @PK_Call_ID = Model.PK_CALL_ID, @PK_RM_ID =PK_RM_ID} )'">Image</button>
                                <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("IvrReports", "VisitReport",new { @PK_CALL_ID = Model.PK_CALL_ID, @PK_RM_ID = PK_RM_ID} )'">Report</button>
                                <button class="btn btn-default news-btn" type="button" onclick="location.href='@Url.Action("AllConcern", "VisitReport",new { @PK_CALL_ID = Model.PK_CALL_ID , @PK_RM_ID =PK_RM_ID} )'">List Of Issues</button>

                            }



                        </div>


                        <div class="col-xs-12">
                            <div class="white-bg section-box-shadow">
                                <h3 class="form-page-title">Item Description</h3>
                                <div class="row">
                                    <div class="col-xs-12 col-sm-offset-1 col-sm-10">
                                        <div class="form-box">
                                            <form method="post" enctype="multipart/form-data">
                                                @Html.HiddenFor(m => m.PK_CALL_ID)
                                                @Html.HiddenFor(m => m.abcid)

                                                <div class="table-responsive">
                                                    <table class="table table-bordered table-striped" id="itemTable">
                                                        <thead style="background-color: #100ED2;color: white;">
                                                            <tr>
                                                                <th>PO Item No</th>
                                                                <th>Item Code</th>
                                                                <th>Description</th>
                                                                <th>UOM</th>
                                                                <th>PO Qty</th>
                                                                <th>Offered Qty</th>
                                                                <th>Accepted Qty</th>
                                                                @if (Model.HeatNoShow == "Yes")
                                                                {
                                                                    <th>Heat No</th>
                                                                }
                                                                <th>Action</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="itemContainer">
                                                            @{
                                                                int i = 0;
                                                            }

                                                            @if (ViewBag.lstConcerns != null && ViewBag.lstConcerns.Count > 0)
                                                            {
                                                                foreach (var item in (IEnumerable<TuvVision.Models.ItemDescriptionModel>)ViewBag.lstConcerns)
                                                                {
                                                                    <tr class="item-row">
                                                                        <td>
                                                                            <input type="text" name="lstConcerns[@i].Po_Item_No"
                                                                                   value="@item.Po_Item_No" class="form-control" />
                                                                        </td>

                                                                        <td>
                                                                            <input type="text" name="lstConcerns[@i].Item_Code"
                                                                                   value="@item.Item_Code" class="form-control" />
                                                                        </td>

                                                                        <td>
                                                                            <textarea name="lstConcerns[@i].ItemCode_Description"
                                                                                      class="form-control autoExpandX">
                                                                                @item.ItemCode_Description
                                                                                </textarea>
                                                                            </td>

                                                                            <td>
                                                                                <select name="lstConcerns[@i].Unit" class="form-control">
                                                                                    <option value="">--Select--</option>
                                                                                    @foreach (var uom in ViewBag.UOM)
                                                                                    {
                                                                                        <option value="@uom.Code"
                                                                                                @(uom.Code == item.Unit ? "selected" : "")>
                                                                                            @uom.Name
                                                                                        </option>
                                                                                    }
                                                                                </select>
                                                                            </td>

                                                                            <td>
                                                                                <input type="text" name="lstConcerns[@i].Po_Quantity"
                                                                                       value="@item.Po_Quantity" class="form-control" />
                                                                            </td>

                                                                            <td>
                                                                                <input type="text" name="lstConcerns[@i].Offered_Quantity"
                                                                                       value="@item.Offered_Quantity" class="form-control" />
                                                                            </td>

                                                                            <td>
                                                                                <input type="text" name="lstConcerns[@i].Accepted_Quantity"
                                                                                       value="@item.Accepted_Quantity" class="form-control" />
                                                                            </td>

                                                                            @if (Model.HeatNoShow == "Yes")
                                                                            {
                                                                                <td>
                                                                                    <input type="text" name="lstConcerns[@i].HeatNumber"
                                                                                           value="@item.HeatNumber" class="form-control" />
                                                                                </td>
                                                                            }

                                                                            <td class="text-center">
                                                                                <button type="button" class="btn btn-danger removeRow">X</button>
                                                                            </td>
                                                                        </tr>
                                                                    i++;
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <tr class="item-row">
                                                                    <td><input type="text" name="lstConcerns[0].Po_Item_No" class="form-control" /></td>
                                                                    <td><input type="text" name="lstConcerns[0].Item_Code" class="form-control" /></td>
                                                                    <td><textarea name="lstConcerns[0].ItemCode_Description" class="form-control autoExpandX"></textarea></td>
                                                                    <td>
                                                                        <select name="lstConcerns[0].Unit" class="form-control">
                                                                            <option value="">--Select--</option>
                                                                            @foreach (var uom in ViewBag.UOM)
                                                                            {
                                                                                <option value="@uom.Code">@uom.Name</option>
                                                                            }
                                                                        </select>
                                                                    </td>
                                                                    <td><input type="text" name="lstConcerns[0].Po_Quantity" class="form-control" /></td>
                                                                    <td><input type="text" name="lstConcerns[0].Offered_Quantity" class="form-control" /></td>
                                                                    <td><input type="text" name="lstConcerns[0].Accepted_Quantity" class="form-control" /></td>

                                                                    @if (Model.HeatNoShow == "Yes")
                                                                    {
                                                                        <td><input type="text" name="lstConcerns[0].HeatNumber" class="form-control" /></td>
                                                                    }

                                                                    <td class="text-center">
                                                                        <button type="button" class="btn btn-danger removeRow">X</button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>

                                                <div class="text-right">
                                                    <button type="button" class="btn btn-success" id="addRow">Add Row</button>
                                                    <button type="submit" class="btn btn-primary">Save</button>
                                                </div>
                                            </form>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div><!-- /.box-shadow -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        var rowIndex = $("#itemContainer .item-row").length;
        var heatNoShow = '@Model.HeatNoShow';

        $("#addRow").click(function () {
            var newRow = $(".item-row:first").clone(true);

            newRow.find("input, textarea, select").each(function () {
                var name = $(this).attr("name");
                if (name) {
                    var newName = name.replace(/\[\d+\]/, '[' + rowIndex + ']');
                    $(this).attr("name", newName).val('');
                }
            });

            if (heatNoShow !== "Yes") {
                newRow.find('div:has(label:contains("Heat number"))').remove();
            }

            $("#itemContainer").append(newRow);
            rowIndex++;
        });

        $(document).on("click", ".removeRow", function () {
            if ($("#itemContainer .item-row").length > 1) {
                $(this).closest(".item-row").remove();
            }
        });
    });
</script>
