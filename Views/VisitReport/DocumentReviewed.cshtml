<script>
    $(document).ready(function () {

        /* ------------------------------------------
           AUTO EXPAND TEXTAREA
        --------------------------------------------*/
        function autoExpand(el) {
            el.style.height = "auto";
            el.style.height = el.scrollHeight + "px";
        }
        $(document).on("input", ".auto-expand", function () {
            autoExpand(this);
        });
        $(".auto-expand").each(function () {
            autoExpand(this);
        });


        /* ------------------------------------------
           SORTABLE ROWS (LIKE INSPECTION ACTIVITY)
        --------------------------------------------*/
        $("#sortableRows").sortable({
            handle: ".dragHandle",
            containment: "#DocumentTable",
            axis: "y",
            placeholder: "sortable-placeholder",
            helper: function (e, tr) {
                var $originals = tr.children();
                var $helper = tr.clone();
                $helper.children().each(function (index) {
                    $(this).width($originals.eq(index).width());
                });
                return $helper;
            },
            update: function () {
                reindex();
            }
        });


        /* ------------------------------------------
           AUTOSUGGEST (LIKE INSPECTION ACTIVITY)
        --------------------------------------------*/
        $(document).on("input", "textarea[name*='Description']", function () {
            let $textarea = $(this);
            let query = $textarea.val().trim();
            let callId = $("#PK_CALL_ID").val();

            let $container = $textarea.siblings(".suggestions-container");
            if ($container.length === 0) {
                $container = $('<div class="suggestions-container"></div>');
                $textarea.after($container);
            }

            if (query.length === 0) {
                $container.empty().hide();
                return;
            }

            $.ajax({
                url: '@Url.Action("GetSuggestions", "VisitReport")',
                data: { Searchres: query, PK_CALL_ID: callId },
                success: function (response) {

                    $container.empty().show();

                    if (!response.success || response.data.length === 0) return;

                    response.data.forEach(item => {
                        let $item = $("<p>")
                            .addClass("suggestion-item")
                            .text(item.Name)
                            .css({
                                padding: "6px",
                                cursor: "pointer",
                                borderBottom: "1px solid #ccc",
                                background: "#fafafa"
                            });

                        $container.append($item);
                    });
                }
            });
        });

        /* Fill textarea on click */
        $(document).on("click", ".suggestion-item", function () {
            let text = $(this).text();
            let $container = $(this).parent();
            let $textarea = $container.siblings("textarea");

            $textarea.val(text).trigger("input");
            $container.empty().hide();
        });

        /* Hide suggestion box */
        $(document).on("click", function (e) {
            if (!$(e.target).closest("textarea, .suggestions-container").length) {
                $(".suggestions-container").empty().hide();
            }
        });


        /* ------------------------------------------
           ADD NEW ROW
        --------------------------------------------*/
        $("#addRow").click(function () {

            let index = $("#sortableRows tr").length;

            let newRow = `
                <tr class="row-item">
                    <td style="text-align:center;">
                        <span class="dragHandle">⠿</span><br />${index + 1}
                    </td>
                    <td>

                        <input type="hidden" name="DocumentList[${index}].PK_DR_ID" value="0" />
                        <input type="hidden" name="DocumentList[${index}].Old_Sequence_No" value="${index + 1}" />
                        <input type="hidden" name="DocumentList[${index}].Sequence_No" class="seqField" value="${index + 1}" />

                        <input type="hidden" name="DocumentList[${index}].Old_QAP_Clause_Number" value="" />
                        <input type="hidden" name="DocumentList[${index}].Old_Description" value="" />

                        <h6>QAP Clause No:</h6>
                        <input type="text"
                               name="DocumentList[${index}].QAP_Clause_Number"
                               placeholder="QAP Clause No."
                               class="form-control-sm QapTxt" value="" />

                        <h6>Description:</h6>
                        <textarea name="DocumentList[${index}].Description"
                                  class="form-control auto-expand grammar-target"
                                  placeholder="Enter detailed description"
                                  rows="2"></textarea>
                                  <div class="grammar-output"></div>

                        <div class="suggestions-container"></div>

                        <button type="button" class="btn btn-danger btn-sm removeRow">X</button>

                    </td>
                </tr>`;

            $("#sortableRows").append(newRow);
            $("#sortableRows").sortable("refresh");
            reindex();
        });


        /* ------------------------------------------
           DELETE ROW
        --------------------------------------------*/
        $(document).on("click", ".removeRow", function () {
            $(this).closest("tr").remove();
            reindex();
        });

        var AddRowFlag = @DocListEmpty.ToString().ToLower();
        if (AddRowFlag) {
            $("#addRow").click();
        }


        /* ------------------------------------------
           RE-INDEX ALL ROWS (MAIN MC BINDER LOGIC)
        --------------------------------------------*/
        function reindex() {

            $("#sortableRows tr").each(function (i) {

                let pk = $(this).find("input[name*='PK_DR_ID']").val();
                let oldSeq = $(this).find("input[name*='Old_Sequence_No']").val();
                let oldQap = $(this).find("input[name*='Old_QAP_Clause_Number']").val();
                let oldDesc = $(this).find("input[name*='Old_Description']").val();

                let qap = $(this).find("input[name$='.QAP_Clause_Number']").val();
                let desc = $(this).find("textarea").val();

                $(this).find("td:first").html(
                    `<span class='dragHandle'>⠿</span><br />${i + 1}`
                );

                $(this).find("input[name*='PK_DR_ID']")
                    .attr("name", `DocumentList[${i}].PK_DR_ID`)
                    .val(pk);

                $(this).find("input[name*='Old_Sequence_No']")
                    .attr("name", `DocumentList[${i}].Old_Sequence_No`)
                    .val(oldSeq);

                $(this).find("input[name*='Old_QAP_Clause_Number']")
                    .attr("name", `DocumentList[${i}].Old_QAP_Clause_Number`)
                    .val(oldQap);

                $(this).find("input[name*='Old_Description']")
                    .attr("name", `DocumentList[${i}].Old_Description`)
                    .val(oldDesc);

                $(this).find(".seqField")
                    .attr("name", `DocumentList[${i}].Sequence_No`)
                    .val(i + 1);

                $(this).find("input[name$='.QAP_Clause_Number']")
                    .attr("name", `DocumentList[${i}].QAP_Clause_Number`)
                    .val(qap);

                $(this).find("textarea")
                    .attr("name", `DocumentList[${i}].Description`)
                    .val(desc);
            });
        }

    });
</script>



@if (isGrammerCheck == 1)
{
    <script>
let grammarTimers = {};

$(document).on("input", ".grammar-target", function () {
    let textarea = $(this);
    let outputDiv = textarea.next(".grammar-output");

    clearTimeout(grammarTimers[textarea[0]]);

    grammarTimers[textarea[0]] = setTimeout(() => {
        runGrammarCheck(textarea, outputDiv);
    }, 600);
});


function runGrammarCheck($textarea, $outputDiv) {

    let text = $textarea.val();

    if (!text.trim()) {
        $outputDiv.html("");
        return;
    }

    $outputDiv.html("<i>Checking...</i>");

    fetch("https://api.languagetool.org/v2/check", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams({
            text: text,
            language: "en-US"
        })
    })
    .then(res => res.json())
    .then(data => {

        if (!data || !data.matches) {
            $outputDiv.html("");
            return;
        }

        if (data.matches.length === 0) {
            $outputDiv.html(`<p class="correct" style="color:green;">✔ Looks good! No grammar errors.</p>`);
            return;
        }

        let html = "";

        data.matches.forEach(m => {
            html += `
                <div class="errorBox" style="background:#ffe4e4; border-left:4px solid red; padding:5px; margin-top:8px;">
                    <b>Issue:</b> ${m.message}<br>
                    <b>Error:</b> "${m.context.text}"<br>
                    <b>Suggestions:</b> ${m.replacements.slice(0, 3).map(r => r.value).join(", ")}
                </div>
            `;
        });

        $outputDiv.html(html);
    })
    .catch(err => {
        console.error(err);
        $outputDiv.html("<span style='color:red;'>Error checking grammar.</span>");
    });
}
    </script>

}




