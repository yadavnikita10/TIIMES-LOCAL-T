<style>
    .auto-expand {
        white-space: pre-wrap;
        overflow: hidden;
        resize: none;
        padding: 8px 10px;
        width: 100%;
        margin-top: 8px;
    }

    .QapTxt {
        width: 100%;
        border: 1px solid #e6e2de;
        font-weight: bold;
    }

    .dragHandle {
        cursor: move;
        font-size: 18px;
    }

    .removeRow {
        margin-top: 8px;
    }

    .suggestions-container {
        position: absolute;
        background: #fef9e7;
        border: 1px solid #ccc;
        z-index: 9999;
        max-height: 200px;
        overflow-y: auto;
        display: none;
        width: 85%;
    }

    .suggestion-item:hover {
        background: #fff3b0;
    }

    .sortable-placeholder {
        background: #ffe6b3 !important;
        height: 40px;
        border: 2px dashed #ff9900;
    }
</style>


