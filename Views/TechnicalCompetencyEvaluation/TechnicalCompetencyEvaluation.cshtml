<script>
    $(document).ready(function () {
        console.log("Filter initialized");
        debugger;

        // ✅ Handle "Select All" checkbox
        $(document).on('change', '#select-all-scopes', function () {
            let isChecked = $(this).is(':checked');
            $('.iaf-scope-filter').prop('checked', isChecked).trigger('change');
        });

        // ✅ Handle individual checkbox changes
        $(document).on('change', '.iaf-scope-filter', function () {
            filterScopeRows();
        });

        function filterScopeRows() {
            // ✅ Get full selected scope values (IAFNumber-IAFName)
            let selectedScopes = $('.iaf-scope-filter:checked').map(function () {
                return $(this).val().toLowerCase().trim(); // normalize case and trim
            }).get();

            console.log("Selected scopes: ", selectedScopes);

            if (selectedScopes.length === 0) {
                // ✅ Hide all if nothing selected
                $('.scope-row').hide();
            } else {
                // ✅ Show only rows that match full scope (number-name)
                $('.scope-row').each(function () {
                    let scope = ($(this).data('scope') || "").toString().toLowerCase().trim();
                    if (selectedScopes.includes(scope)) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            // ✅ Maintain "Select All" checkbox sync
            let allChecked = $('.iaf-scope-filter').length === $('.iaf-scope-filter:checked').length;
            $('#select-all-scopes').prop('checked', allChecked);
        }

        // ✅ Trigger filtering on page load
        filterScopeRows();
    });
</script>




