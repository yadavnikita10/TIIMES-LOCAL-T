    function convertToInputDateFormat(dateStr) {
        if (!dateStr) return '';

        // If already in YYYY-MM-DD, just return it
        if (/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) {
            return dateStr;
        }

        // If it's like DD-MM-YYYY or DD/MM/YYYY, handle it
        var parts = dateStr.includes('-') ? dateStr.split('-') : dateStr.split('/');

        if (parts.length !== 3) return '';

        var day = parts[0].padStart(2, '0');
        var month = parts[1].padStart(2, '0');
        var year = parts[2];

        // Convert to YYYY-MM-DD (for input type="date" or server format)
        return `${year}-${month}-${day}`;
    }


