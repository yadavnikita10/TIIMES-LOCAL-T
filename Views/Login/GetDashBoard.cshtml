            function captureImage() {
                const width = canvas.width;
                const height = canvas.height;

                context.drawImage(video, 0, 0, width, height);

                const imageData = context.getImageData(0, 0, width, height);
                const data = imageData.data;
                const totalPixels = data.length / 4;

                let blackPixels = 0;

                // Count black pixels
                for (let i = 0; i < data.length; i += 4) {
                    const r = data[i];
                    const g = data[i + 1];
                    const b = data[i + 2];

                    if (r < 10 && g < 10 && b < 10) {
                        blackPixels++;
                    }
                }

                const blackRatio = blackPixels / totalPixels;
                console.log(`Black Ratio: ${(blackRatio * 100).toFixed(1)}%`);

                // 🚫 Reject if mostly black
                if (blackRatio > 0.75) { // 75%+ black pixels
                    alert("Selfie is fully black. Please take your photo again.");

                    context.clearRect(0, 0, width, height);
                    canvas.style.display = 'none';
                    video.style.display = 'block';
                    document.getElementById('selfieBase64').value = '';
                    document.getElementById('compressedImage').style.display = 'none';

                    // Restart camera
                    startCamera({ facingMode: "user" });
