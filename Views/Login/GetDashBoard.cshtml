    function parseDate_ddmmyyyy(dateStr) {
        if (!dateStr) return null;
        const parts = dateStr.split('/');
        if (parts.length !== 3) return null;
        const day = parseInt(parts[0], 10);
        const month = parseInt(parts[1], 10) - 1; // months are 0-indexed
        const year = parseInt(parts[2], 10);
        return new Date(year, month, day);
    }
    function parseISODateString(dateStr) {
        // Expected input format: "YYYY-MM-DD"
        const parts = dateStr.split('-');
        if (parts.length !== 3) return null;
        const year = parseInt(parts[0], 10);
        const month = parseInt(parts[1], 10) - 1; // JS months are 0-indexed
        const day = parseInt(parts[2], 10);
        return new Date(year, month, day);
    }


    function base64ToBlob(base64, mimeType) {
        const byteChars = atob(base64.split(',')[1]); // Remove the prefix
        const byteArrays = [];
        for (let offset = 0; offset < byteChars.length; offset += 512) {
            const slice = byteChars.slice(offset, offset + 512);
            const byteNumbers = new Array(slice.length);
            for (let i = 0; i < slice.length; i++) {
                byteNumbers[i] = slice.charCodeAt(i);
            }
            const byteArray = new Uint8Array(byteNumbers);
            byteArrays.push(byteArray);
        }
        return new Blob(byteArrays, { type: mimeType });
    }

    function getLocationFromCoords(lat, lon) {
        const url = `https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lon}&format=json&addressdetails=1`;
        fetch(url)
            .then(response => response.json())
            .then(data => {
                //verifyLocation();
                //console.log('OpenStreetMap Geocoding Data:', data);
                if (data && data.display_name) {
                    document.getElementById('txtplace').value = data.display_name;
                } else {
                    console.error('No results from OSM:', data);
                    alert('Could not determine location. Please try again.');
                }
            })
            .catch(error => {
                console.error('Error fetching location from OpenStreetMap:', error);
                alert('Error fetching location. Please check your internet connection.');
            });
    }

    function getCurrentTime() {
        const now = new Date();
        return now.toLocaleTimeString('en-GB', { hour12: false });
    }

</script>


