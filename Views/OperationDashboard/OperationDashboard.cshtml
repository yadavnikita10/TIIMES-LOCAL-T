                    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
                    <script>
                        $(document).ready(function () {
                            $.ajax({
                                url: '@Url.Action("GetFolder")',
                                type: 'GET',
                                success: function (folders) {
                                    $("#folderButtonsContainer").empty();

                                    folders.forEach(function (folderName) {
                                        // Create a button with folderName as the value
                                        var btn = $('<button>')
                                            .attr('type', 'button')        // button type
                                            .val(folderName)               // Set the value attribute
                                            .text(folderName)              // Optional: display text on button
                                            .addClass('fy-box')
                                            .click(function () {
                                                var selectedFolder = $(this).val();  // Get the folder from value
                                                alert('You clicked folder: ' + selectedFolder);
                                                // Or send selectedFolder to your controller
                                            });

                                        $("#folderButtonsContainer").append(btn);
                                    });
                                },
                                error: function () {
                                    alert('Failed to load folders.');
                                }
                            });
                        });

                        
                    </script>
